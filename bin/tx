#!/usr/bin/env bash
# =============================================================================
#  Ternuxx — Native Termux host and optional Debian PRoot workstation CLI
#
#  Native Termux owns services and control; Debian guest apps use the PRoot provider.
#
#  Copyright (c) 2026 Sobuj Miah (@soobujmiah)
#  License: not yet selected; see README.md.
#  https://github.com/soobujmiah/ternuxx
# =============================================================================
set -u

# --- Version ------------------------------------------------------------
TERNUXX_VERSION="0.1.0"
TERNUXX_REPO="https://github.com/soobujmiah/ternuxx"
TERNUXX_LIB_DIR="${TERNUXX_LIB_DIR:-}"
TERNUXX_STATE_DIR="${TERNUXX_STATE_DIR:-$HOME/.local/share/ternuxx}"
TERNUXX_LOG_DIR="${TERNUXX_LOG_DIR:-${TMPDIR:-/data/data/com.termux/files/usr/tmp}/ternuxx}"
TERNUXX_LOG_FILE="$TERNUXX_LOG_DIR/ternuxx.log"
export TERNUXX_STATE_DIR
TERNUXX_JSON=0
TERNUXX_VERBOSE=0
TERNUXX_QUIET=0

# --- Locate libraries ---------------------------------------------------
_NT_BIN_DIR=""
_NT_SRC_DIR=""
_TN_LIB_DIR=""

# Checkout: bin/tx + lib/*.sh, or installed lib under the Ternuxx data prefix.
_NT_BIN_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd -P)" || _NT_BIN_DIR=""

for _try in \
  "${TERNUXX_LIB_DIR:-}" \
  "${_NT_BIN_DIR}/../lib/ternuxx" \
  "${_NT_BIN_DIR}/../lib" \
  "${PREFIX:-/data/data/com.termux/files/usr}/lib/ternuxx" \
  "$HOME/.local/share/ternuxx/lib"; do
  [ -n "$_try" ] || continue
  if [ -f "$_try/core.sh" ]; then
    _TN_LIB_DIR="$(CDPATH= cd -- "$_try" 2>/dev/null && pwd -P)"
    break
  fi
done
unset _try

if [ -z "$_TN_LIB_DIR" ]; then
  echo "[FATAL] Cannot locate Ternuxx libraries. Clone or reinstall." >&2
  exit 1
fi

. "$_TN_LIB_DIR/core.sh"

# --- Lazy-load a library module ----------------------------------------
_nt_use() {
  local lib="$1"
  [ -n "${_NT_LOADED[$lib]:-}" ] && return 0
  local f="$_TN_LIB_DIR/${lib}.sh"
  if [ -f "$f" ]; then
    . "$f"
    _NT_LOADED["$lib"]=1
    return 0
  fi
  nt_die "Internal error: library '$lib' not found at $f" 99
}
declare -A _NT_LOADED

# --- Command registry --------------------------------------------------
_nt_resolve_slug() {
  case "$1" in
    up) echo start ;; dn) echo stop ;; rs) echo restart ;; st) echo status ;;
    ck) echo check ;; inf) echo info ;; doc) echo doctor ;;
    mg|mng) echo management ;;
    cp) echo checkpoint ;; ra) echo remote ;; rb) echo reboot ;;
    bt) echo boot ;; wl) echo wakelock ;; in) echo install ;;
    bk) echo backup ;; rc) echo recovery ;; rt) echo restore ;; g) echo guides ;; h) echo help ;;
    *) echo "$1" ;;
  esac
}

_nt_dispatch() {
  local requested="$1" cmd; cmd="$(_nt_resolve_slug "$1")"; shift
  if [ "$requested" = management ]; then
    printf "%s\n" "[WARN] tx management is deprecated; use tx mng." >&2
  fi
  if [ "$cmd" = help ]; then _nt_use help && nt_help "$(_nt_resolve_slug "${1:-}")"; return 0; fi
  case "$cmd" in h) cmd=help ;; esac
  if [ "$cmd" = help ]; then _nt_use help && nt_help "\${1:-}"; return 0; fi



  if declare -F "nt_cmd_${cmd}" >/dev/null 2>&1; then
    "nt_cmd_${cmd}" "$@"
    return $?
  fi

  local lib_map=""
  case "$cmd" in
    guides)
      local choice="" repo_root="${_NT_BIN_DIR%/bin}"
      while :; do
        printf '%s\n' '' 'Ternuxx Native Termux and Debian guide' \
          '  1) Preview Native package setup' \
          '  2) Check system health' \
          '  3) Check desktop status' \
          '  4) Start the Native desktop' \
          '  5) Read installation guide' \
          '  6) Read operations guide' \
          '  7) Set up the pinned CPU model' \
          '  8) Check CPU, GPU, and NPU inference status' \
          '  9) Inspect Debian or preview fresh guest setup' \
          ' 10) Open terminal management (TUI)' \
          ' 11) Open authenticated Web management' \
          ' 12) Open GTK management center' \
          '  0) Exit'
        [ -t 0 ] || { printf '%s\n' 'Interactive menu needs a terminal. Run `tx help`, `tx install preview`, `tx tui`, `tx web`, or `tx gui`.'; return 0; }
        read -r -p 'Choose an item: ' choice || return 0
        case "$choice" in
          1) "$_NT_BIN_DIR/tx" install preview; return $? ;;
          2) "$_NT_BIN_DIR/tx" doctor; return $? ;;
          3) "$_NT_BIN_DIR/tx" status; return $? ;;
          4) "$_NT_BIN_DIR/tx" start; return $? ;;
          5|6)
            local guide="$repo_root/docs/INSTALLATION.md"
            [ "$choice" = 6 ] && guide="$repo_root/docs/OPERATIONS.md"
            if [ -r "$guide" ]; then
              if command -v less >/dev/null 2>&1; then less "$guide"; else cat "$guide"; fi
            else printf 'Guide file not found: %s\n' "$guide" >&2; return 1; fi ;;
          7) "$_NT_BIN_DIR/tx" ai setup; return $? ;;
          8)
            local result=0
            "$_NT_BIN_DIR/tx" ai status || result=1
            "$_NT_BIN_DIR/tx" ai devices || result=1
            "$_NT_BIN_DIR/tx" ai npu status || result=1
            return "$result" ;;
          9)
            local guest_user=""
            "$_NT_BIN_DIR/tx" proot status || return $?
            read -r -p 'New Debian guest username for a read-only setup preview (Enter to skip): ' guest_user || return 0
            [ -n "$guest_user" ] || return 0
            "$_NT_BIN_DIR/tx" proot setup fresh-preview --user "$guest_user"
            return $? ;;
          10) "$_NT_BIN_DIR/tx" tui; return $? ;;
          11) "$_NT_BIN_DIR/tx" web; return $? ;;
          12) "$_NT_BIN_DIR/tx" gui; return $? ;;
          0) return 0 ;;
          *) printf '%s\n' 'Please choose 0 through 12.' ;;
        esac
      done
      ;;
    start|stop|restart|status) lib_map="desktop" ;;
    audio)                     lib_map="audio" ;;
    ai)                        lib_map="ai" ;;
    app)                       lib_map="management" ;;
    graphics)                   lib_map="desktop" ;;
    gui)                       lib_map="launch" ;;
    proot|pgui|db)             lib_map="proot" ;;
    terminal)                   lib_map="terminal" ;;
    tui)                        lib_map="tui" ;;
    web)                        lib_map="management" ;;
    checkpoint)                lib_map="continuity" ;;
    ssh)                       lib_map="ssh" ;;
    remote)                    lib_map="remote_access" ;;
    reboot|boot|wakelock)     lib_map="reboot" ;;
    backup|restore|recovery)  lib_map="recovery" ;;
    check|doctor)             lib_map="doctor" ;;
    info)                     lib_map="info" ;;
    install)                  lib_map="phases" ;;
    *)                        lib_map="$cmd" ;;
  esac

  if [ -f "$_TN_LIB_DIR/${lib_map}.sh" ]; then
    _nt_use "$lib_map" 2>/dev/null || true
  fi

  if declare -F "nt_cmd_${cmd}" >/dev/null 2>&1; then
    "nt_cmd_${cmd}" "$@"
    return $?
  fi

  if [ "$TERNUXX_JSON" = "1" ]; then
    nt_json_object "error" "fatal" \
      "message" "Unknown command: $cmd" \
      "requested_command" "$cmd"
  else
    nt_fail "Unknown command: $cmd"
    echo "Run 'tx --help' for usage." >&2
  fi
  return 1
}

# --- Parse global flags ------------------------------------------------
_NT_ARGS=()
_HELP_REQUESTED=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json)      TERNUXX_JSON=1; shift ;;
    --verbose)   TERNUXX_VERBOSE=1; shift ;;
    --quiet)     TERNUXX_QUIET=1; shift ;;
    --help|-h)   _HELP_REQUESTED=1; shift ;;
    --version|-V) echo "Ternuxx v${TERNUXX_VERSION}"; echo "${TERNUXX_REPO}"; exit 0 ;;
    *) _NT_ARGS+=("$1"); shift ;;
  esac
done

set -- "${_NT_ARGS[@]}"

if [ "$_HELP_REQUESTED" -eq 1 ]; then
  if [ $# -eq 0 ]; then
    _nt_use "help" && nt_help ""; exit 0
  fi
  _nt_use "help" && nt_help "$(_nt_resolve_slug "$1")"; exit 0
fi
unset _HELP_REQUESTED

# --- Dispatch ----------------------------------------------------------
if [ $# -eq 0 ]; then
  _nt_use "help" && nt_help ""; exit 0
fi

COMMAND="$1"; shift
_nt_dispatch "$COMMAND" "$@"
